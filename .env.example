# OpenAI-compatible model provider (Qwen / Alibaba Cloud Model Studio)
MODEL_API_KEY=replace-with-your-api-key
MODEL_NAME=qwen3.7-flash
MODEL_BASE_URL=https://<your-workspace-id>.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# Legacy SiliconFlow: leave MODEL_API_KEY and MODEL_BASE_URL empty to use it.
# SILICONFLOW_API_KEY=replace-with-your-api-key
# SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
TAVILY_API_KEY=replace-with-your-api-key
MODEL_REQUEST_TIMEOUT_SECONDS=60
EVIDENCE_EXTRACTION_TIMEOUT_SECONDS=120
EVIDENCE_EXTRACTION_MAX_TOKENS=6144
EVIDENCE_EXTRACTION_ENABLE_THINKING=false
MODEL_MAX_RETRIES=0
RESEARCH_TASK_TIMEOUT_SECONDS=300
RESEARCH_PROGRESS_INTERVAL_SECONDS=15
SHOW_EVIDENCE_DEBUG=false
# Optional verifier overrides: empty values reuse the research provider/model.
VERIFIER_MODEL_NAME=
VERIFIER_MODEL_API_KEY=
VERIFIER_MODEL_BASE_URL=
VERIFIER_ENABLE_THINKING=false
MAX_VERIFY_CLAIMS_PER_BATCH=6
MAX_VERIFICATION_CONTEXT_CHARS=12000
VERIFICATION_MAX_TOKENS=2048
VERIFICATION_TIMEOUT_SECONDS=120
SHOW_VERIFICATION_DEBUG=false
# Run-wide Claim relevance; gaps are generated without extra LLM calls.
MAX_RELEVANCE_CLAIMS_PER_BATCH=12
MAX_RELEVANCE_CONTEXT_CHARS=8000
RELEVANCE_MAX_TOKENS=2048
# Total across batches and their single timeout retry, not per request.
RELEVANCE_TIMEOUT_SECONDS=180
SHOW_GAP_DEBUG=false
# Phase 4C supplemental stage only. Rounds=0 disables it; current version max=1.
MAX_RERESEARCH_ROUNDS=1
MAX_RERESEARCH_TASKS_PER_ROUND=2
MAX_RERESEARCH_GAPS_PER_TASK=4
MAX_RERESEARCH_LLM_CALLS=12
RERESEARCH_MAX_SEARCH_CALLS=2
RERESEARCH_MAX_FETCH_CALLS=2
MAX_RERESEARCH_PLANNING_CONTEXT_CHARS=8000
RERESEARCH_PLANNING_MAX_TOKENS=2048
RERESEARCH_PLANNING_TIMEOUT_SECONDS=60
# Phase 5A: tool-free Writer; factual paragraphs use only SUPPORTED + ALIGNED.
MAX_WRITER_CONTEXT_CHARS=24000
MAX_REPORT_OUTPUT_TOKENS=4096
MAX_EVIDENCE_PER_WRITING_CLAIM=3
MAX_WRITING_EVIDENCE_CHARS=400
MIN_WRITER_CLAIM_COVERAGE=0.6
WRITER_TIMEOUT_SECONDS=180
WRITER_ENABLE_THINKING=false
SHOW_WRITER_DEBUG=false
MAX_REPORT_GROUNDING_CONTEXT_CHARS=24000
REPORT_GROUNDING_MAX_TOKENS=3072
REPORT_GROUNDING_TIMEOUT_SECONDS=120
